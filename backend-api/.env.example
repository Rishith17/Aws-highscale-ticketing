PORT=8080
AWS_REGION=ap-south-1

# DynamoDB Table Name (created in AWS DynamoDB Console)
DYNAMODB_TABLE_NAME=TicketInventory

# SQS FIFO Queue URL (from AWS SQS Console)
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/YOUR_ACCOUNT_ID/ticket-purchases.fifo

# Amazon RDS PostgreSQL Database Credentials
DB_HOST=concert-ticket-db.xyz.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ticketdb
DB_USER=dbadmin
DB_PASSWORD=YourSecurePassword123!

# Leave empty when connecting to real AWS! (Only set when testing offline with LocalStack)
LOCALSTACK_ENDPOINT=
